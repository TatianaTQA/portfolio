      "item": [
        {
          "name": "List of Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Each user has a unique id\", function () {",
                  "    const users = jsonData.data;",
                  "    const ids = users.map(user => user.id);",
                  "    const uniqueIds = new Set(ids);",
                  "    pm.expect(uniqueIds.size).to.eql(ids.length);",
                  "});",
                  "",
                  "pm.test(\"Each user has all required fields\", function () {",
                  "const users = jsonData.data;",
                  "const requiredFields = [\"id\", \"title\", \"firstName\", \"lastName\", \"picture\"];",
                  "for (let user of users) {",
                  "    for (let field of requiredFields) {",
                  "        pm.expect(user).to.have.property(field);",
                  "        }",
                  "    }",
                  "    });",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create New User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"dynamic_firstName\", \"Tania\" + Math.floor(Math.random() * 100));",
                  "pm.collectionVariables.set(\"dynamic_lastName\", \"Sun\" + Math.floor(Math.random() * 100));",
                  "pm.collectionVariables.set(\"dynamic_email\", \"ZxC\" + Math.floor(Math.random() * 100) + \"@my.pl\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let responseJson = pm.response.json();",
                  "let requestBody = JSON.parse(pm.request.body.raw);",
                  "",
                  "console.log(responseJson);",
                  "var userID = responseJson.id; ",
                  "console.log(\"ID пользователя - \" + userID);",
                  "pm.collectionVariables.set(\"ID_user\", userID);",
                  "",
                  "// 1. Статус код 200",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Email in response matches email from request body\", function () {",
                  "    const requestEmail = requestBody.email;",
                  "     pm.expect(responseJson.email.toLowerCase()).to.eql(requestEmail.toLowerCase());",
                  "});",
                  "",
                  "",
                  "pm.test(\"Response contains non-empty id\", function () {",
                  "    pm.expect(responseJson).to.have.property(\"id\");",
                  "    pm.expect(responseJson.id).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"firstName in response matches request body\", function () {",
                  "    pm.expect(responseJson.firstName).to.eql(requestBody.firstName);",
                  "});",
                  "",
                  "pm.test(\"lastName in response matches request body\", function () {",
                  "    pm.expect(responseJson.lastName).to.eql(requestBody.lastName);",
                  "});",
                  "",
                  "pm.test(\"gender in response matches request body\", function () {",
                  "    pm.expect(responseJson.gender).to.eql(requestBody.gender);",
                  "});",
                  "",
                  "pm.test(\"phone in response matches request body\", function () {",
                  "    pm.expect(responseJson.phone).to.eql(requestBody.phone);",
                  "});",
                  "",
                  "pm.test(\"Response contains registerDate and updatedDate\", function () {",
                  "    pm.expect(responseJson).to.have.property(\"registerDate\");",
                  "    pm.expect(responseJson).to.have.property(\"updatedDate\");",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
